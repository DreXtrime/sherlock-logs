# Required
# Password for the devops user created on all VMs
DEVOPS_PASSWORD=
# Password for grafana
GRAFANA_PASSWORD=
# discord hook url to send monitoring alerts to
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------------
# Optional
# URL of an apt-cacher-ng proxy to speed up package downloads
# during provisioning. See README for setup instructions.
# APT_CACHE_URL=http://192.168.56.1:3142